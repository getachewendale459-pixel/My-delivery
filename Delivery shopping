<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>የመጀመሪያ ገጼ</title>
  <link rel="stylesheet" href="style.css">
<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
  }

  header {
    background-color: #2e7d32;
    color: white;
    padding: 20px;
    text-align: center;
  }

  header button {
    background-color: white;
    color: #2e7d32;
  }

  #cart-list {
    list-style: none;
    padding: 0;
  }

  .card img {
    max-width: 100%;
  }

  .products {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 25px;
  }

  .card {
    background-color: white;
    width: 220px;
    padding: 20px;
    margin: 0;
    border-radius: 15px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    text-align: center;
    box-sizing: border-box;
  }

  .price {
    color: #2e7d32;
    font-weight: bold;
  }

  button {
    background-color: #2e7d32;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
  }

  @media (max-width: 600px) {
    .card {
      width: 100%;
    }
  }
</style>
</head>
<body>
  <header>
  <h1>Welcome to E.G delivery!!</h1>
  <p>with: <span id="count">0</span> products</p>
  <p>total: <span id="total">0</span> birr</p>
  <ul id="cart-list"></ul>
  <button onclick="clearCart()">clear </button>
  </header>
<main>
  <div class="products" id="products"></div>
</main>
<script>
  const products = [
    { name: "coffee in kg", price: 700, image: "coffee.jpg" },
    { name: "honey in kg", price: 400, image: "honey.jpeg" },
    { name: "butter in kg", price: 300, image: "butter.jpeg" },
    { name: "milk in ltr.", price: 120, image: "milk.jpeg" }
  ];

let cart = JSON.parse(localStorage.getItem("cart")) || [];

  function addToCart(name, price) {
  let found = false;

  for (const item of cart) {
    if (item.name === name) {
      item.qty = item.qty + 1;
      found = true;
    }
  }

  if (!found) {
    cart.push({ name: name, price: price, qty: 1 });
  }

  showCart();
}

  function showCart() {
  let total = 0;
  let count = 0;
  const list = document.getElementById("cart-list");
  list.innerHTML = "";

  if (cart.length === 0) {
    list.innerHTML = "<li> no product</li>";
  }

  for (let i = 0; i < cart.length; i++) {
    const item = cart[i];
    const lineTotal = item.price * item.qty;

    list.innerHTML += `<li>${item.name} x${item.qty} - ${lineTotal} birr
      <button onclick="removeItem(${i})">x</button></li>`;

    total = total + lineTotal;
    count = count + item.qty;
  }

    document.getElementById("count").textContent = count;
  document.getElementById("total").textContent = total;
  localStorage.setItem("cart", JSON.stringify(cart));
}

  function clearCart() {
    cart = [];
    showCart();
    }
    function removeItem(index) {
  if (cart[index].qty > 1) {
    cart[index].qty = cart[index].qty - 1;
  } else {
    cart.splice(index, 1);
  }
  showCart();
}

  const box = document.getElementById("products");

  for (const item of products) {
    box.innerHTML += `
      <div class="card">
        <img src="${item.image}" alt="${item.name}" width="200">
        <h3>${item.name}</h3>
        <p class="price">${item.price} birr</p>
        <button onclick="addToCart('${item.name}', ${item.price})">add</button>
      </div>
    `;
  }
  showCart();
</script>
  </body>
</html>
